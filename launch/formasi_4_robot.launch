<launch>
    <!-- Gazebo empty world -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="paused" value="false"/>
        <arg name="use_sim_time" value="true"/>
        <arg name="gui" value="true"/>
        <arg name="headless" value="false"/>
        <arg name="debug" value="false"/>
    </include>

    <!-- Robot 1: y = -2.25 -->
    <group ns="r1">
        <param name="robot_description"
               command="$(find xacro)/xacro
                        $(find skid_steer_description)/urdf/main_skid.xacro
                        robot_name:=r1"/>
        <node pkg="robot_state_publisher"
              type="robot_state_publisher"
              name="rsp">
            <param name="tf_prefix" value="r1"/>
        </node>
        <node pkg="gazebo_ros" type="spawn_model" name="spawn_r1"
              args="-urdf -param robot_description -model r1
                    -robot_namespace r1
                    -x 0.0 -y -2.25 -z 0.1 -Y 0.0"/>
    </group>

    <!-- Robot 2: y = -0.75 -->
    <group ns="r2">
        <param name="robot_description"
               command="$(find xacro)/xacro
                        $(find skid_steer_description)/urdf/main_skid.xacro
                        robot_name:=r2"/>
        <node pkg="robot_state_publisher"
              type="robot_state_publisher"
              name="rsp">
            <param name="tf_prefix" value="r2"/>
        </node>
        <node pkg="gazebo_ros" type="spawn_model" name="spawn_r2"
              args="-urdf -param robot_description -model r2
                    -robot_namespace r2
                    -x 0.0 -y -0.75 -z 0.1 -Y 0.0"/>
    </group>

    <!-- Robot 3: y = 0.75 -->
    <group ns="r3">
        <param name="robot_description"
               command="$(find xacro)/xacro
                        $(find skid_steer_description)/urdf/main_skid.xacro
                        robot_name:=r3"/>
        <node pkg="robot_state_publisher"
              type="robot_state_publisher"
              name="rsp">
            <param name="tf_prefix" value="r3"/>
        </node>
        <node pkg="gazebo_ros" type="spawn_model" name="spawn_r3"
              args="-urdf -param robot_description -model r3
                    -robot_namespace r3
                    -x 0.0 -y 0.75 -z 0.1 -Y 0.0"/>
    </group>

    <!-- Robot 4: y = 2.25 -->
    <group ns="r4">
        <param name="robot_description"
               command="$(find xacro)/xacro
                        $(find skid_steer_description)/urdf/main_skid.xacro
                        robot_name:=r4"/>
        <node pkg="robot_state_publisher"
              type="robot_state_publisher"
              name="rsp">
            <param name="tf_prefix" value="r4"/>
        </node>
        <node pkg="gazebo_ros" type="spawn_model" name="spawn_r4"
              args="-urdf -param robot_description -model r4
                    -robot_namespace r4
                    -x 0.0 -y 2.25 -z 0.1 -Y 0.0"/>
    </group>

</launch>
